#!/bin/sh
#
# Programs the EDIDs in DDCRAM_port<n>.bin, kept next to libDDCRAM_EDID.so,
# into the HDMI receiver at boot. An empty file STOP or STOP_EDID in the root
# of a USB stick skips it.
#
# shellcheck source=/dev/null
. /dtv/SGO.env

LIB="${LIBSO_DIR:-$SYSROOT/opt/privateer/usr/libso}/libDDCRAM_EDID.so"
LOG=/dtv/DDCRAM_EDID.log

case $1 in
	start)
	for usb in /dtv/usb/sd*; do
		if [ -e "$usb/STOP" ] || [ -e "$usb/STOP_EDID" ]; then
			echo "STOP file found, EDIDs left alone."
			exit 0
		fi
	done
	if [ -f "$LIB" ] && pidof exeTV > /dev/null; then
		rm -f "$LOG"
		samyGOso -T -B -l "$LIB" LOAD HPD
	fi
	;;
	stop)
	;;
	status)
	cat "$LOG" 2> /dev/null || echo "Not run"
	;;
	*)
	echo "Usage: $0 {start|stop|status}" >&2
	;;
esac
