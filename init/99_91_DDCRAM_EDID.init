#!/bin/sh
#
# Inject 5.1 EDID (Dolby Digital + DTS + 5.1 Speaker Allocation) directly into
# MStar MST12 on-chip HDMI DDCRAM at boot, pulsing HPD only for ports that changed.
#
. /dtv/SGO.env

SODIR=$SYSROOT/opt/privateer/usr/libso
[ "$LIBSO_DIR" ] && SODIR=$LIBSO_DIR

stop_bootloop()
{
	for USB in /dtv/usb/sd* ; do
		[ -e "$USB/STOP" ] && echo "STOP found. Exiting." && exit 1
		[ -e "$USB/STOP_EDID" ] && echo "STOP_EDID found. Exiting." && exit 1
	done
}

case $1 in
	start)
	stop_bootloop
	if [ -n "$(pidof exeTV)" ] && [ -f "$SODIR/libDDCRAM_EDID.so" ]; then
		rm -f /dtv/DDCRAM_EDID.log
		samyGOso -T -B -l "$SODIR/libDDCRAM_EDID.so" LOAD HPD
	fi
	;;
	stop)
	;;
	status)
	[ -f /dtv/DDCRAM_EDID.log ] && cat /dtv/DDCRAM_EDID.log || echo "Not run"
	;;
	*)
	echo "Usage: $0 {start|stop|status}" 1>&2
	exit 0
	;;
esac
