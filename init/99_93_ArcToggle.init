#!/bin/sh
#
# Loads libArcToggle into exeAPP at boot so the DVR button (0x72) toggles
# SPDIF/ARC audio between PCM and Dolby Digital and never opens the universal-
# remote setup prompt. Words in libArcToggle.conf next to the library replace
# the default (KEY:DVR). '#' starts a comment. An empty STOP or STOP_ARCTOGGLE
# file in the root of a USB stick skips it.
#
# shellcheck source=/dev/null
. /dtv/SGO.env

LIB="${LIBSO_DIR:-$SYSROOT/opt/privateer/usr/libso}/libArcToggle.so"
CONF="${LIB%.so}.conf"
LOG=/dtv/ArcToggle.log
OPTIONS="KEY:DVR"

case $1 in
	start)
	for usb in /dtv/usb/sd*; do
		if [ -e "$usb/STOP" ] || [ -e "$usb/STOP_ARCTOGGLE" ]; then
			echo "STOP file found, audio key left alone."
			exit 0
		fi
	done
	if [ -f "$LIB" ]; then
		i=0
		while [ "$i" -lt 15 ]; do
			pidof exeAPP > /dev/null && break
			i=$((i + 1))
			sleep 1
		done
		if pidof exeAPP > /dev/null; then
			cr=$(printf '\r')
			if [ -f "$CONF" ]; then
				conf_opts=$(sed "s/#.*//; s/$cr//" "$CONF")
				[ -n "$(printf '%s' "$conf_opts" | tr -d '[:space:]')" ] && OPTIONS="$conf_opts"
			fi
			rm -f "$LOG"
			# One argument per word.
			# shellcheck disable=SC2086
			samyGOso -n exeAPP -B -r -l "$LIB" $OPTIONS
		fi
	fi
	;;
	stop)
	;;
	status)
	cat "$LOG" 2> /dev/null || echo "Not started"
	;;
	*)
	echo "Usage: $0 {start|stop|status}" >&2
	;;
esac
